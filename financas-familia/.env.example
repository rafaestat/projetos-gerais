# ---------------------------------------------------------------------------
# Como o app lê a planilha que é a fonte da verdade do orçamento.
# Copie este arquivo para .env.local e preencha. Nunca versione o .env.local.
# ---------------------------------------------------------------------------

# ID da planilha (o trecho entre /d/ e /edit na URL do Google Sheets).
SHEET_ID=1M5g_V8PXcmfsyL4QLs625TfdBkGy4mrK10h0OOzRc-Y

# api | public | fixture
#   api     — conta de serviço do Google; funciona com a planilha privada (recomendado)
#   public  — export CSV; exige a planilha com "qualquer pessoa com o link pode ver"
#   fixture — dados de exemplo embutidos, para rodar sem credencial nenhuma
SHEETS_MODE=api

# Nome das abas. Aceita também "gid:123456" (o número que aparece na URL
# ao clicar na aba) — mais seguro quando o nome tem acento ou espaço.
SHEET_TAB_TRANSACOES=Transacoes
SHEET_TAB_CATEGORIAS=Categorias

# --- Só para SHEETS_MODE=api -----------------------------------------------
# JSON da conta de serviço (uma linha só) ou o mesmo JSON em base64.
# Depois de criar a conta, compartilhe a planilha com o e-mail dela (leitura).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}

# --- Opcionais --------------------------------------------------------------
# Segundos de cache antes de reler a planilha (padrão 900 = 15 min).
REVALIDATE_SECONDS=900

# Senha compartilhada da casa. Se definida, o app pede login antes de mostrar
# qualquer número. Obrigatória se você publicar o app na internet.
# APP_PASSWORD=

# Ordem de dia/mês quando a data vier como 05/06/2026 (dmy é o padrão brasileiro).
DATE_ORDER=dmy
